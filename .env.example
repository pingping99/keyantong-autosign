# Copy this file to .env and fill in your credentials
# cp .env.example .env

# Required: AbleSci account credentials
ABLESCI_EMAIL=your@example.com
ABLESCI_PASSWORD=your_password

# Optional: Check frequency (Go duration format, e.g. 30m, 1h)
CHECK_INTERVAL=30m

# Optional: Retry interval on sign-in failure
RETRY_INTERVAL=10m

# Optional: Force sign-in on program startup (true/false)
FORCE_SIGN_ON_START=true

# Optional: Timezone
TZ=Asia/Shanghai

# Optional: Data directory for logs and state files
DATA_DIR=./data
