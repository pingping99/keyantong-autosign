# AbleSci 单账户凭证；邮箱和密码必须同时设置
ABLESCI_EMAIL=your@example.com
ABLESCI_PASSWORD=your_password

# 调度设置
CHECK_INTERVAL=30m
RETRY_INTERVAL=10m
SIGN_JITTER_MAX=5m
FORCE_SIGN_ON_START=false
EARLY_HOUR_THRESHOLD=8
LATE_HOUR_THRESHOLD=22

# 系统设置
TZ=Asia/Shanghai
DATA_DIR=/app/data
HEALTH_CHECK_HOST=127.0.0.1
HEALTH_CHECK_PORT=8080

# Docker Compose 非 root 用户映射。Linux 下建议改为 id -u / id -g 的结果。
PUID=1000
PGID=1000

# 可选：显式指定配置文件
# CONFIG_FILE=/app/config.yaml
