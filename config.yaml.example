---
# AbleSci 自动签到配置（仅支持单账户）
# 配置优先级: 环境变量 > config.yaml/config.yml > 默认值

email: user@example.com
password: "replace-with-your-password"

data_dir: ./data
timezone: Asia/Shanghai

# 定时策略
check_interval: 30m
retry_interval: 10m
sign_jitter_max: 5m
force_sign_on_start: false
early_hour_threshold: 8
late_hour_threshold: 22

# 健康检查
health_check_port: 8080

# API 设置，一般无需修改
api:
  base_url: https://www.ablesci.com
  login_path: /site/login
  sign_path: /user/sign
